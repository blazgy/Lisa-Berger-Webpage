{
  "name": "lisa-berger-booking",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "dev": "npm run build:site && wrangler dev",
    "test": "npm run build:site && vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "deploy:staging": "npm run build:site && wrangler deploy --env staging",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "worker-mailer": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.7.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "lucide": "1.80.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.0"
  }
}
